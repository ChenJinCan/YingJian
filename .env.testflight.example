# Copy to .env.testflight. Keep the local file and all signing material outside Git.

# App Store Connect API key.
ASC_KEY_ID=
ASC_ISSUER_ID=
ASC_KEY_PATH=./AuthKey_XXXXXXXXXX.p8

# Local fastlane match signing storage.
MATCH_GIT_URL=
MATCH_PASSWORD=
MATCH_GIT_BASIC_AUTHORIZATION=
MATCH_GIT_PRIVATE_KEY=

# Optional local keychain unlock for codesign access.
KEYCHAIN_PASSWORD=

# Apple Developer team metadata.
DEVELOPER_TEAM_ID=

# Release identity never belongs in this file. Supply VERSION, BUILD_NUMBER,
# RELEASE_PUBLIC_VERSION, RELEASE_REMOTE_LATEST_VERSION, RELEASE_REMOTE_LATEST_BUILD,
# RELEASE_BASELINE_VERIFIED_AT, and RELEASE_SOURCE_COMMIT only after reading
# the current App Store Connect state.

# Required only when App Review needs a signed-in demo account.
APP_REVIEW_DEMO_USER=
APP_REVIEW_DEMO_PASSWORD=

# Explicit export-compliance input for a future authorized submission lane.
APP_USES_NON_EXEMPT_ENCRYPTION=false
