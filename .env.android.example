# Copy to .env.android. Keep the local file and all signing material outside Git.
ANDROID_SIGNING_PROPERTIES_FILE=/absolute/path/to/yingjian/signing.properties

# Release identity never belongs in this file. Supply VERSION_NAME,
# VERSION_CODE, RELEASE_PUBLIC_VERSION, RELEASE_REMOTE_LATEST_VERSION,
# RELEASE_REMOTE_LATEST_BUILD, RELEASE_BASELINE_VERIFIED_AT, and
# RELEASE_SOURCE_COMMIT only after reading the current Google Play state.
